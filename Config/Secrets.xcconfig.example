// Copy this file to Config/Secrets.xcconfig and fill in real values.
// Config/Secrets.xcconfig is gitignored. Escape the // in every URL as /$()/,
// otherwise xcconfig treats the rest of the line as a comment.

// Deadwax API origin. The .invalid placeholder leaves auth and the API disabled.
API_URL = https:/$()/your-api.invalid

// PowerSync service origin. The placeholder leaves sync disabled.
POWERSYNC_URL = https:/$()/your-instance.powersync.journeyapps.com

// Optional shared APNs registration gateway. Leave the URL blank to register
// device tokens with the Deadwax API.
PUSH_GATEWAY_URL =
PUSH_GATEWAY_APPLICATION_ID = deadwaxclub

// Optional PostHog analytics and error tracking for local builds. Leave the
// token blank to disable PostHog. TestFlight builds take both values from the
// POSTHOG_PROJECT_TOKEN secret and POSTHOG_HOST variable instead.
POSTHOG_PROJECT_TOKEN =
POSTHOG_HOST = https:/$()/eu.i.posthog.com
