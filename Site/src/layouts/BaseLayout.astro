---
// Shared by every app's site (Scripts/SHARED_SITE.md). The app's own header,
// footer and styles fill it in.
import "../styles/global.css";
import DocumentHead from "../components/DocumentHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  bodyClass?: string;
  /** Set false for a page served at many URLs, such as a share link viewer. */
  canonical?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  bodyClass,
  canonical = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <DocumentHead
    title={title}
    description={description}
    ogTitle={ogTitle}
    canonical={canonical}
  />
  <body class={bodyClass}>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
