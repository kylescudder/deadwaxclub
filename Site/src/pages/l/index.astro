---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shared list · Deadwax Club"
  description="A shared vinyl record list on Deadwax Club."
  bodyClass="list-page"
  canonical={false}
>
  <div class="container list-container">
    <main id="main">
      <div class="state" id="loading">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading list...</p>
      </div>
    </main>
  </div>

  <script is:inline src="/js/config.js"></script>
  <script is:inline type="module" src="/js/list.js"></script>
</BaseLayout>
